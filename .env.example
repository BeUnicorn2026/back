PORT=7070
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_SAME_SITE=auto
PRELOAD_SPEAKER_MODEL=true
SPEAKER_RECOGNITION_ENABLED=true
SPEAKER_INFERENCE_ORIGIN=
SPEAKER_INFERENCE_TOKEN_FILE=
SPEAKER_INFERENCE_MODEL_ID=wespeaker/voxblink2-simam-resnet100
SPEAKER_INFERENCE_DIMENSIONS=256
SPEAKER_MATCH_THRESHOLD=0.45
SPEAKER_MATCH_MARGIN=0.05
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
OPENAI_ANALYSIS_MODEL=
OPENAI_EXPLANATION_MODEL=
# Stage 2 개인화 필터(자기소개 기반) 모델. 비우면 EXPLANATION → ANALYSIS 순으로 상속.
OPENAI_FILTER_MODEL=
# Stage 1 실시간 용어 추출 모델. 비우면 ANALYSIS 모델을 상속.
OPENAI_TERMS_MODEL=
# Private Go AI service. Compose overrides the hosts for container networking.
GO_PORT=7071
GO_HOST=127.0.0.1
GO_AI_ORIGIN=http://127.0.0.1:7071
AI_API_TOKEN=

# OpenRouter is optional. With no key, MeetMap and Live Map run in explicit local
# mode. With a key, provider errors surface after one retry; they never fall back.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90

# Live Map is an explicit opt-in because it sends each finalized speech turn
# to an external LLM in real time and incurs per-turn usage costs.
LIVEMAP_ENABLED=false
# Optional; when empty, defaults to OPENROUTER_MODEL.
LIVEMAP_MODEL=
# Optional polling interval in milliseconds.
LIVEMAP_POLL_INTERVAL_MS=1000

AI_WORKER_COUNT=4
AI_QUEUE_SIZE=64
# May be lowered, but values above 1048576 are clamped to the absolute 1 MiB cap.
AI_MAXIMUM_BODY_BYTES=1048576
EMAIL_VERIFICATION_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
VOICE_BIOMETRIC_KEY=
DATABASE_URL=
POSTGRES_POOL_MAX=
SPEAKER_STORAGE=local
BLOB_READ_WRITE_TOKEN=
BLOB_SPEAKER_PREFIX=
SPEAKER_MODEL_PATH=
SPEAKER_MODEL_CACHE=
SPEAKER_MATCH_THRESHOLD=0.84
SPEAKER_MATCH_MARGIN=0.05
SPEAKER_DUPLICATE_AUDIO_THRESHOLD=0.985
TRUST_PROXY=false
CLOUDFLARE_TUNNEL_TOKEN=
BACKEND_ENV_FILE=.env
HOST_REPOSITORY_PATH=/Users/compy/voice-partition/back
UPDATE_INTERVAL_SECONDS=60
